<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- L'app ne fait aucun tracking publicitaire -->
	<key>NSPrivacyTracking</key>
	<false/>

	<!-- Aucun domaine de tracking -->
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- Aucune donnée utilisateur collectée -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<!-- APIs sensibles utilisées -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- UserDefaults : historique des parties et état premium (local uniquement) -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1 : accès aux données écrites par la même app, pour son propre fonctionnement -->
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
